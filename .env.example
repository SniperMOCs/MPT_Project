DB_URL=postgres://user:password@server:port/db_name?sslmode=disable
# Вставьте данные из pgAdmin
# user      Username
# password  пароль, введенный при установке
# server    хост (default: localhost)
# port      порт, выбранный при установке (default: 5432)
# db_name   название базы данных

JWT_SECRET= yoursecretkey #Ваш секретный ключ
TOKEN_TTL=1h #Время работы токена jwt
# Сохранить этот файл как .env